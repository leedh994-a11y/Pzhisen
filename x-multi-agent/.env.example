# Required: Google Gemini API key
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: model (default gemini-2.5-pro)
GEMINI_MODEL=gemini-2.5-pro

# Optional: custom Gemini endpoint / proxy
# GEMINI_BASE_URL=https://your-custom-endpoint.com/v1beta

# Optional: run browser headless (true/false). Keep false for first login.
HEADLESS=false

# Default profile used by `npm run tweet`
DEFAULT_PROFILE=pzhisen

# Optional HTTP backend (npm run server)
AGENT_PORT=8787
AGENT_API_TOKEN=change-me-to-a-long-random-secret

# === Recommended: Cookie posting (no Desktop / no npm run login) ===
# Export from a browser where you are already logged into https://x.com
# Chrome DevTools → Application → Cookies → https://x.com
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# Prefer cookie mode for HTTP API when cookies are set (true/false)
TWEET_MODE=cookie
