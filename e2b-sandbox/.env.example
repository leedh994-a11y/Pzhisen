# 阿里云函数计算云沙箱（北京）
E2B_API_KEY=
E2B_API_URL=https://api.cn-beijing.e2b.fc.aliyuncs.com
E2B_DOMAIN=cn-beijing.e2b.fc.aliyuncs.com

# 预置 Claude Code 镜像（可按控制台最新版本调整）
E2B_FROM_IMAGE=fc-e2b-registry.cn-beijing.cr.aliyuncs.com/runtime/claude-code:v0.0.37

# 稳定模板名（推荐复用；加 --unique 时会追加时间戳）
E2B_TEMPLATE_NAME=claude-code

# 构建规格（官方推荐）
E2B_CPU_COUNT=2
E2B_MEMORY_MB=8192

# 沙箱超时（秒）
E2B_SANDBOX_TIMEOUT=600

# 中国站：百炼 API Key（sk- 开头）
BAILIAN_API_KEY=
ANTHROPIC_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic
ANTHROPIC_MODEL=qwen3.7-max
