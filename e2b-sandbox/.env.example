# 阿里云函数计算云沙箱
# API Key 与地域必须一致（本仓库实测可用：杭州 cn-hangzhou）
E2B_API_KEY=
E2B_API_URL=https://api.cn-hangzhou.e2b.fc.aliyuncs.com
E2B_DOMAIN=cn-hangzhou.e2b.fc.aliyuncs.com

# 预置 Claude Code 镜像（地域需与上面一致）
E2B_FROM_IMAGE=fc-e2b-registry.cn-hangzhou.cr.aliyuncs.com/runtime/claude-code:v0.0.37

# 稳定模板名（推荐复用；加 --unique 时会追加时间戳）
E2B_TEMPLATE_NAME=claude-code

# 构建规格（官方推荐）
E2B_CPU_COUNT=2
E2B_MEMORY_MB=8192

# 沙箱超时（秒）；长期会话建议 3600，每次 prompt 会续期
E2B_SANDBOX_TIMEOUT=3600

# 中国站：百炼 API Key（sk- 开头）
BAILIAN_API_KEY=
ANTHROPIC_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic
ANTHROPIC_MODEL=qwen3.7-max
